<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Views — hb.interview.slot  (Screen 7.3 — Lịch rảnh PV)
         ══════════════════════════════════════════════════════════════════ -->

    <!-- Search view -->
    <record id="hb_view_interview_slot_search" model="ir.ui.view">
        <field name="name">hb.interview.slot.search</field>
        <field name="model">hb.interview.slot</field>
        <field name="arch" type="xml">
            <search string="Tìm lịch rảnh">
                <field name="user_id" string="Người phỏng vấn"/>
                <field name="department_id" string="Phòng ban"/>
                <filter string="Còn trống" name="filter_available"
                        domain="[('state', '=', 'available')]"/>
                <filter string="Đã đặt" name="filter_booked"
                        domain="[('state', '=', 'booked')]"/>
                <separator/>
                <group>
                    <filter string="Ngày" name="group_date"
                            context="{'group_by': 'start_datetime:day'}"/>
                    <filter string="Người PV" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Phòng ban" name="group_dept"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Trạng thái" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Calendar view — màn hình chính 7.3, week mode = Weekly Availability Matrix -->
    <record id="hb_view_interview_slot_calendar" model="ir.ui.view">
        <field name="name">hb.interview.slot.calendar</field>
        <field name="model">hb.interview.slot</field>
        <field name="arch" type="xml">
            <calendar string="Lịch rảnh phỏng vấn"
                      date_start="start_datetime"
                      date_stop="stop_datetime"
                      color="user_id"
                      mode="week"
                      quick_create="0">
                <field name="user_id"/>
                <field name="state"/>
                <field name="applicant_ids"/>
            </calendar>
        </field>
    </record>

    <!-- List view — grouped by day -->
    <record id="hb_view_interview_slot_list" model="ir.ui.view">
        <field name="name">hb.interview.slot.list</field>
        <field name="model">hb.interview.slot</field>
        <field name="arch" type="xml">
            <list string="Lịch rảnh phỏng vấn"
                  decoration-success="state == 'available'"
                  decoration-muted="state == 'booked'">
                <field name="start_datetime" string="Bắt đầu" optional="show"/>
                <field name="stop_datetime" string="Kết thúc" optional="show"/>
                <field name="user_id" string="Người PV"/>
                <field name="department_id" string="Phòng ban" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-danger="state == 'booked'"/>
                <field name="applicant_ids" string="Ứng viên" widget="many2many_tags" optional="show"/>
                <field name="applicant_count" string="Số UV" optional="show"/>
                <field name="notes" string="Ghi chú" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="hb_view_interview_slot_form" model="ir.ui.view">
        <field name="name">hb.interview.slot.form</field>
        <field name="model">hb.interview.slot</field>
        <field name="arch" type="xml">
            <form string="Chi tiết lịch rảnh">
                <header>
                    <!-- Không còn nút "Đánh dấu đã đặt": state suy ra từ danh sách
                         ứng viên, thêm/bớt ứng viên là đủ. -->
                    <button name="action_mark_available" type="object"
                            string="Gỡ hết ứng viên"
                            invisible="state == 'available'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,booked"/>
                </header>
                <sheet>
                    <group>
                        <group string="Thông tin slot">
                            <field name="user_id"/>
                            <field name="department_id"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'available'"
                                   decoration-danger="state == 'booked'"/>
                        </group>
                        <group string="Thời gian">
                            <field name="start_datetime"/>
                            <field name="stop_datetime"/>
                        </group>
                    </group>
                    <group string="Ứng viên phỏng vấn trong slot">
                        <field name="applicant_ids" nolabel="1" colspan="2"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <group string="Ghi chú">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Wizard — hb.interview.slot.wizard  (TBP khai báo batch slot)
         ══════════════════════════════════════════════════════════════════ -->

    <record id="hb_view_interview_slot_wizard_form" model="ir.ui.view">
        <field name="name">hb.interview.slot.wizard.form</field>
        <field name="model">hb.interview.slot.wizard</field>
        <field name="arch" type="xml">
            <form string="Khai báo lịch rảnh phỏng vấn">
                <sheet>
                    <div class="oe_title">
                        <h2>Khai báo lịch rảnh phỏng vấn</h2>
                        <p class="text-muted">
                            Thêm các khung giờ bạn rảnh để BP Tuyển dụng lên lịch phỏng vấn.
                        </p>
                    </div>
                    <group>
                        <field name="user_id"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" string="Danh sách slot rảnh">
                            <field name="date" string="Ngày"/>
                            <field name="start_hour" string="Bắt đầu"/>
                            <field name="end_hour" string="Kết thúc"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_create_slots" type="object"
                            string="Tạo lịch rảnh" class="btn-primary"/>
                    <button special="cancel" string="Hủy"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action mở wizard từ menu -->
    <record id="hb_action_slot_wizard" model="ir.actions.act_window">
        <field name="name">Khai báo lịch rảnh</field>
        <field name="res_model">hb.interview.slot.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Server action: mở wizard từ Action dropdown trên list/calendar -->
    <record id="hb_server_action_slot_wizard" model="ir.actions.server">
        <field name="name">Khai báo lịch rảnh theo tuần…</field>
        <field name="model_id" ref="model_hb_interview_slot"/>
        <field name="binding_model_id" ref="model_hb_interview_slot"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Khai báo lịch rảnh',
    'res_model': 'hb.interview.slot.wizard',
    'view_mode': 'form',
    'target': 'new',
}
        </field>
    </record>

</odoo>
