<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Sheet 7.5 — Danh sách phỏng vấn (hr.applicant extended)
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── Custom List View ── -->
    <record id="hb_view_applicant_interview_list" model="ir.ui.view">
        <field name="name">hr.applicant.hocba.interview.list</field>
        <field name="model">hr.applicant</field>
        <field name="arch" type="xml">
            <list string="Danh sách phỏng vấn"
                decoration-success="interview_result == 'pass'"
                decoration-danger="interview_result == 'fail' or attendance_status == 'absent'"
                decoration-warning="interview_result == 'potential'">
                <field name="date_received"       string="Thời gian"/>
                <field name="ctv_tuyen_dung"       string="CTV"/>
                <field name="partner_name"         string="Họ tên ứng viên"/>
                <field name="partner_phone"        string="SĐT" optional="show"/>
                <field name="email_from"           string="Email" optional="hide"/>
                <field name="job_id"               string="Vị trí"/>
                <field name="cv_link"              string="Link CV" widget="url" optional="hide"/>
                <field name="interview_date"       string="Ngày hẹn PV"/>
                <field name="interview_time"       string="Giờ PV"/>
                <field name="interviewer_name"     string="Người PV"/>
                <field name="attendance_status"    string="Trạng thái" widget="badge"
                    decoration-success="attendance_status == 'present'"
                    decoration-danger="attendance_status == 'absent'"/>
                <field name="interview_result"     string="Kết quả PV" widget="badge"
                    decoration-success="interview_result == 'pass'"
                    decoration-danger="interview_result == 'fail'"
                    decoration-warning="interview_result == 'potential'"/>
                <field name="offer_content"        string="Offer" optional="show"/>
                <field name="start_date"           string="Ngày nhận việc" optional="show"/>
                <field name="offer_note"           string="Note" optional="show"/>
                <field name="candidate_confirmed"  string="UV xác nhận mail" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form View Inherit — add "Kết quả PV" tab ── -->
    <record id="hb_view_applicant_interview_form_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.hocba.interview.form.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hocba_recruitments.hb_view_applicant_cv_form_inherit"/>
        <field name="arch" type="xml">
            <page name="cv_screening" position="after">
                <page string="Kết quả PV" name="interview_result_tab">
                    <group string="Kết quả phỏng vấn" col="2">
                        <group>
                            <field name="attendance_status"/>
                            <field name="interview_result"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="candidate_confirmed"
                                placeholder="Đã xác nhận / Đã phản hồi"/>
                        </group>
                        <field name="offer_content"
                            colspan="2"
                            placeholder="Nội dung lương offer. VD: Lương cứng 8tr, thử việc 85% tháng 1, 100% tháng 2, COM 1%"/>
                        <field name="offer_note"
                            colspan="2"
                            placeholder="Ghi chú nội bộ về offer và nhận việc..."/>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <!-- ── Search View Inherit — interview-specific filters ── -->
    <record id="hb_view_applicant_interview_search_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.hocba.interview.search.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hocba_recruitments.hb_view_applicant_cv_search_inherit"/>
        <field name="arch" type="xml">
            <filter name="filter_agree" position="after">
                <separator/>
                <filter name="filter_pv_present" string="Đã đến PV"
                    domain="[('attendance_status','=','present')]"/>
                <filter name="filter_pv_absent" string="Không đến PV"
                    domain="[('attendance_status','=','absent')]"/>
                <separator/>
                <filter name="filter_pv_pass" string="Kết quả Pass"
                    domain="[('interview_result','=','pass')]"/>
                <filter name="filter_pv_fail" string="Kết quả Fail"
                    domain="[('interview_result','=','fail')]"/>
                <filter name="filter_pv_potential" string="Tiềm năng"
                    domain="[('interview_result','=','potential')]"/>
                <separator/>
                <filter name="filter_has_offer" string="Đã có Offer"
                    domain="[('offer_content','!=',False),('offer_content','!=','')]"/>
                <filter name="filter_confirmed" string="UV Đã xác nhận"
                    domain="[('candidate_confirmed','!=',False),('candidate_confirmed','!=','')]"/>
                <filter name="filter_start_date_set" string="Đã có ngày nhận việc"
                    domain="[('start_date','!=',False)]"/>
            </filter>
            <filter name="group_interviewer" position="after">
                <filter name="group_interview_result" string="Kết quả PV"
                    context="{'group_by':'interview_result'}"/>
                <filter name="group_attendance" string="Tham gia PV"
                    context="{'group_by':'attendance_status'}"/>
                <filter name="group_interview_date" string="Tháng PV"
                    context="{'group_by':'interview_date:month'}"/>
            </filter>
        </field>
    </record>

</odoo>
