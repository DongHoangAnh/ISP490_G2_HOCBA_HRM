<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Modern Time-Off dashboard rendered by an OWL client action.
             The component (static/src/js/hr_holidays_modern.js) loads real
             hr.leave data via ORM and renders KPI cards + analytics. -->
        <record id="action_hr_holidays_modern_dashboard" model="ir.actions.client">
            <field name="name">Bảng điều khiển Nghỉ phép</field>
            <field name="tag">hr_holidays_modern_dashboard</field>
        </record>

        <!-- Menu under Time Off > Reporting -->
        <menuitem
            id="menu_hr_holidays_modern_dashboard"
            name="Bảng điều khiển (Modern)"
            parent="hr_holidays.menu_hr_holidays_dashboard"
            action="action_hr_holidays_modern_dashboard"
            sequence="1"/>
    </data>
</odoo>
