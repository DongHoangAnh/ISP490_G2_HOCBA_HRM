<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pivot: Thu − Chi theo phòng ban / mục / tháng -->
    <record id="hocba_fin_voucher_pivot" model="ir.ui.view">
        <field name="name">hocba.fin.voucher.pivot</field>
        <field name="model">hocba.fin.voucher</field>
        <field name="arch" type="xml">
            <pivot string="Báo cáo Thu − Chi">
                <field name="voucher_date" interval="month" type="row"/>
                <field name="voucher_type" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph: dòng tiền theo thời gian -->
    <record id="hocba_fin_voucher_graph" model="ir.ui.view">
        <field name="name">hocba.fin.voucher.graph</field>
        <field name="model">hocba.fin.voucher</field>
        <field name="arch" type="xml">
            <graph string="Dòng tiền theo thời gian" type="line">
                <field name="voucher_date" interval="month"/>
                <field name="voucher_type"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action báo cáo: chỉ phiếu đã ghi sổ -->
    <record id="action_hocba_fin_report" model="ir.actions.act_window">
        <field name="name">Báo cáo dòng tiền</field>
        <field name="res_model">hocba.fin.voucher</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="domain">[('state', '=', 'posted')]</field>
        <field name="context">{'search_default_group_month': 1}</field>
    </record>
</odoo>
