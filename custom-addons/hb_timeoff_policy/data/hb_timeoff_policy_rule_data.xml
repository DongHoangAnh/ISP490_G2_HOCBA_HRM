<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        FUNC-TO-003: Chính sách Nghỉ phép theo Loại Nhân viên
        CONF-TO-06: Leave Allocation by Employee Group

        Policy Mapping:
        ┌─────────────────────┬──────────────────────────────────┬───────────┬─────────────────────────────┐
        │ Loại NV             │ Loại nghỉ phép                   │ Ngày/năm  │ Accrual Plan                │
        ├─────────────────────┼──────────────────────────────────┼───────────┼─────────────────────────────┤
        │ Toàn thời gian      │ Năm, Ốm, Không lương, Thai sản, │ 12 ngày   │ Phép Năm Toàn Thời Gian     │
        │                     │ Khẩn cấp                         │           │                             │
        │ Giảng viên chính    │ Năm, Ốm, Không lương, Khẩn cấp  │ 12 ngày   │ Phép Năm Toàn Thời Gian     │
        │ Trợ giảng           │ Năm, Ốm, Không lương             │ 6 ngày    │ Phép Năm Trợ Giảng (0.5/th) │
        │ Bán thời gian       │ Không lương                       │ 0         │ Không                       │
        │ Giảng viên thỉnh    │ Không lương                       │ 0         │ Không                       │
        │ Cộng tác viên       │ Không                             │ 0         │ Không (BR-021)              │
        └─────────────────────┴──────────────────────────────────┴───────────┴─────────────────────────────┘
    -->
    <data noupdate="1">

        <!-- ============================================================
             ACCRUAL PLAN: Trợ Giảng — 0.5 ngày/tháng, tối đa 6 ngày
             (riêng biệt với plan fulltime để có cap khác)
        ============================================================ -->
        <record id="hb_accrual_plan_annual_ta" model="hr.leave.accrual.plan">
            <field name="name">Phép Năm — Trợ Giảng</field>
            <field name="time_off_type_id" ref="hb_timeoff_config.hb_leave_type_annual"/>
            <field name="accrued_gain_time">start</field>
            <field name="can_be_carryover">True</field>
            <field name="carryover_date">other</field>
            <field name="carryover_month">3</field>
            <field name="carryover_day">31</field>
        </record>

        <record id="hb_accrual_level_annual_ta" model="hr.leave.accrual.level">
            <field name="accrual_plan_id" ref="hb_accrual_plan_annual_ta"/>
            <field name="milestone_date">creation</field>
            <field name="start_count">0</field>
            <field name="start_type">day</field>
            <field name="added_value">0.5</field>
            <field name="added_value_type">day</field>
            <field name="frequency">monthly</field>
            <field name="cap_accrued_time">True</field>
            <field name="maximum_leave">6</field>
            <!-- Carry-over: giữ tối đa 3 ngày sang năm sau -->
            <field name="action_with_unused_accruals">all</field>
            <field name="carryover_options">limited</field>
            <field name="postpone_max_days">3</field>
        </record>

        <!-- ============================================================
             POLICY RULES — 6 loại nhân viên
        ============================================================ -->

        <!-- 1. Nhân viên Toàn thời gian -->
        <record id="hb_policy_fulltime" model="hb.timeoff.policy.rule">
            <field name="name">Chính sách — Nhân viên Toàn thời gian</field>
            <field name="employment_type">fulltime</field>
            <field name="leave_type_ids" eval="[
                (4, ref('hb_timeoff_config.hb_leave_type_annual')),
                (4, ref('hb_timeoff_config.hb_leave_type_sick')),
                (4, ref('hb_timeoff_config.hb_leave_type_unpaid')),
                (4, ref('hb_timeoff_config.hb_leave_type_maternity')),
                (4, ref('hb_timeoff_config.hb_leave_type_emergency')),
            ]"/>
            <field name="allocation_mode">accrual</field>
            <field name="accrual_plan_id" ref="hb_timeoff_config.hb_accrual_plan_annual_fulltime"/>
            <field name="annual_days">12</field>
            <field name="notes">
                Toàn bộ 5 loại nghỉ phép. Phép năm tích lũy 1 ngày/tháng, tối đa 12 ngày.
                Carry-over tối đa 5 ngày, hết hạn 31/3 năm sau.
                Phê duyệt: Manager + HR (double validation).
            </field>
        </record>

        <!-- 2. Giảng viên Chính thức -->
        <record id="hb_policy_teacher" model="hb.timeoff.policy.rule">
            <field name="name">Chính sách — Giảng viên (Chính thức)</field>
            <field name="employment_type">teacher</field>
            <field name="leave_type_ids" eval="[
                (4, ref('hb_timeoff_config.hb_leave_type_annual')),
                (4, ref('hb_timeoff_config.hb_leave_type_sick')),
                (4, ref('hb_timeoff_config.hb_leave_type_unpaid')),
                (4, ref('hb_timeoff_config.hb_leave_type_emergency')),
            ]"/>
            <field name="allocation_mode">accrual</field>
            <field name="accrual_plan_id" ref="hb_timeoff_config.hb_accrual_plan_annual_fulltime"/>
            <field name="annual_days">12</field>
            <field name="notes">
                4 loại nghỉ (không có Thai sản). Phép năm tích lũy 1 ngày/tháng, tối đa 12 ngày.
                Khi nghỉ trong ngày dạy: cần Academic Manager phê duyệt (FUNC-TO-004).
            </field>
        </record>

        <!-- 3. Trợ giảng -->
        <record id="hb_policy_ta" model="hb.timeoff.policy.rule">
            <field name="name">Chính sách — Trợ giảng</field>
            <field name="employment_type">ta</field>
            <field name="leave_type_ids" eval="[
                (4, ref('hb_timeoff_config.hb_leave_type_annual')),
                (4, ref('hb_timeoff_config.hb_leave_type_sick')),
                (4, ref('hb_timeoff_config.hb_leave_type_unpaid')),
            ]"/>
            <field name="allocation_mode">accrual</field>
            <field name="accrual_plan_id" ref="hb_accrual_plan_annual_ta"/>
            <field name="annual_days">6</field>
            <field name="notes">
                3 loại nghỉ. Phép năm tích lũy 0.5 ngày/tháng, tối đa 6 ngày.
                Carry-over tối đa 3 ngày. Phê duyệt: Manager trực tiếp.
            </field>
        </record>

        <!-- 4. Nhân viên Bán thời gian -->
        <record id="hb_policy_parttime" model="hb.timeoff.policy.rule">
            <field name="name">Chính sách — Nhân viên Bán thời gian</field>
            <field name="employment_type">parttime</field>
            <field name="leave_type_ids" eval="[
                (4, ref('hb_timeoff_config.hb_leave_type_unpaid')),
            ]"/>
            <field name="allocation_mode">none</field>
            <field name="annual_days">0</field>
            <field name="notes">
                Chỉ có Nghỉ Không Lương. Không có phép năm. Phê duyệt: Manager trực tiếp.
            </field>
        </record>

        <!-- 5. Giảng viên Thỉnh giảng -->
        <record id="hb_policy_visiting" model="hb.timeoff.policy.rule">
            <field name="name">Chính sách — Giảng viên Thỉnh giảng</field>
            <field name="employment_type">visiting</field>
            <field name="leave_type_ids" eval="[
                (4, ref('hb_timeoff_config.hb_leave_type_unpaid')),
            ]"/>
            <field name="allocation_mode">none</field>
            <field name="annual_days">0</field>
            <field name="notes">
                Chỉ có Nghỉ Không Lương. Không có phép năm. Phê duyệt: Academic Manager.
            </field>
        </record>

        <!-- 6. Cộng tác viên — BR-021: không có allocation -->
        <record id="hb_policy_ctv" model="hb.timeoff.policy.rule">
            <field name="name">Chính sách — Cộng tác viên</field>
            <field name="employment_type">ctv</field>
            <field name="allocation_mode">none</field>
            <field name="annual_days">0</field>
            <field name="notes">
                BR-021: Cộng tác viên không có bất kỳ allocation nghỉ phép nào.
                Nút nghỉ phép bị ẩn trên form nhân viên.
            </field>
        </record>

    </data>
</odoo>
