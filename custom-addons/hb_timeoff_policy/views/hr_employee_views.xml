<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         Kế thừa hr.employee form — thêm:
         1. Smart button "Chính sách" ở button_box
         2. Trường x_hb_leave_emp_type trong tab Work Information
         3. Section chính sách nghỉ phép trong tab Settings
    ============================================================ -->
    <record id="view_employee_form_hb_policy" model="ir.ui.view">
        <field name="name">hr.employee.form.hb.policy</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- 1. Smart button: hiển thị số lần thay đổi chính sách -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_policy_log"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-calendar-check-o"
                    groups="hr_holidays.group_hr_holidays_user">
                    <div class="o_stat_info">
                        <field name="x_policy_log_count" class="o_stat_value"/>
                        <span class="o_stat_text">Chính sách</span>
                    </div>
                </button>
            </xpath>

            <!-- 2. Thêm x_hb_leave_emp_type sau job_id trong tab Work Information -->
            <xpath expr="//div[@id='o_work_information']//field[@name='job_id']" position="after">
                <field name="x_hb_leave_emp_type" string="Loại nhân viên"/>
            </xpath>

            <!-- 3. Thêm section chính sách trong tab Settings -->
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Chính sách Nghỉ phép" name="hb_leave_policy">
                    <group>
                        <field name="x_current_policy_id" readonly="1"/>
                        <field name="x_policy_override"/>
                    </group>
                    <group>
                        <button
                            name="action_reapply_leave_policy"
                            type="object"
                            string="Áp dụng lại Chính sách"
                            class="btn-secondary"
                            icon="fa-refresh"
                            groups="hr_holidays.group_hr_holidays_manager"
                            invisible="x_policy_override"/>
                    </group>
                </group>
            </xpath>

        </field>
    </record>

    <!-- ============================================================
         BR-021: Ẩn nút Nghỉ phép (Time Off) cho Cộng tác viên (CTV).
         Kế thừa trực tiếp view của hr_holidays để chắc chắn nút
         action_time_off_dashboard đã tồn tại trong arch cha.
    ============================================================ -->
    <record id="view_employee_form_hb_hide_leave_ctv" model="ir.ui.view">
        <field name="name">hr.employee.form.hb.hide.leave.ctv</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_holidays.view_employee_form_leave_inherit"/>
        <field name="arch" type="xml">
            <button name="action_time_off_dashboard" position="attributes">
                <attribute name="invisible">not show_leaves or company_id not in allowed_company_ids or x_employment_status == 'ctv'</attribute>
            </button>
        </field>
    </record>

</odoo>
