<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        CFG-TO-05: Tạo 5 loại nghỉ chuẩn cho Học Bá
        CFG-TO-01: Cấu hình approval hierarchy theo loại nghỉ

        leave_validation_type:
            'no_validation' = Không cần duyệt
            'hr'            = Chỉ HR Officer duyệt
            'manager'       = Chỉ Manager trực tiếp duyệt
            'both'          = Manager + HR (double validation)

        requires_allocation:
            True  = Phải có allocation trước mới nghỉ được
            False = Nghỉ tự do, không cần allocation

        unpaid:
            True  = Trừ lương khi nghỉ
            False = Không trừ lương (paid leave)

        QUY ƯỚC HỌC BÁ (theo phân quyền mới):
        - CHỈ "Nghỉ Phép Năm" requires_allocation=True → trừ vào quỹ 12 ngày cố định.
        - CHỈ "Nghỉ Không Lương" unpaid=True → không có lương.
        - Mọi loại còn lại: requires_allocation=False (nghỉ tự do, không cần
          allocation) và unpaid=False (có lương).
    -->
    <data noupdate="1">

        <!-- ====================================================
             1. NGHỈ PHÉP NĂM (Annual Leave)
             - Cần allocation (accrual 12 ngày/năm)
             - Phải duyệt cả Manager lẫn HR
             - Có lương
        ==================================================== -->
        <record id="hb_leave_type_annual" model="hr.leave.type">
            <field name="name">Nghỉ Phép Năm</field>
            <field name="time_type">leave</field>
            <field name="requires_allocation">True</field>
            <field name="leave_validation_type">hr</field>
            <field name="allocation_validation_type">hr</field>
            <field name="unpaid">False</field>
            <!-- Phase 6: cho phép nghỉ nửa ngày (Sáng/Chiều) -->
            <field name="request_unit">half_day</field>
            <field name="color">10</field>
        </record>

        <!-- ====================================================
             2. NGHỈ ỐM (Sick Leave)
             - Không cần allocation trước (nộp khi phát sinh)
             - HR Officer duyệt (kèm giấy tờ y tế - enforce ở Phase 3)
             - Có lương (theo BHXH)
        ==================================================== -->
        <record id="hb_leave_type_sick" model="hr.leave.type">
            <field name="name">Nghỉ Ốm</field>
            <field name="time_type">leave</field>
            <field name="requires_allocation">False</field>
            <field name="leave_validation_type">hr</field>
            <field name="unpaid">False</field>
            <!-- Phase 6: cho phép nghỉ nửa ngày (Sáng/Chiều) -->
            <field name="request_unit">half_day</field>
            <field name="color">1</field>
        </record>

        <!-- ====================================================
             3. NGHỈ KHÔNG LƯƠNG (Unpaid Leave)
             - Không cần allocation
             - Phải duyệt cả Manager lẫn HR (tác động lương)
             - Không có lương → tạo work entry LEAVE_UNPAID
        ==================================================== -->
        <record id="hb_leave_type_unpaid" model="hr.leave.type">
            <field name="name">Nghỉ Không Lương</field>
            <field name="time_type">leave</field>
            <field name="requires_allocation">False</field>
            <field name="leave_validation_type">hr</field>
            <field name="unpaid">True</field>
            <!-- cho phép nghỉ nửa ngày (Sáng/Chiều) -->
            <field name="request_unit">half_day</field>
            <field name="color">2</field>
        </record>

        <!-- ====================================================
             4. NGHỈ THAI SẢN (Maternity Leave)
             - KHÔNG cần allocation (nghỉ tự do, không trừ quỹ 12 ngày)
             - Manager + HR duyệt
             - Có lương (hưởng BHXH)
        ==================================================== -->
        <record id="hb_leave_type_maternity" model="hr.leave.type">
            <field name="name">Nghỉ Thai Sản</field>
            <field name="time_type">leave</field>
            <field name="requires_allocation">False</field>
            <field name="leave_validation_type">hr</field>
            <field name="unpaid">False</field>
            <field name="request_unit">day</field>
            <field name="color">4</field>
        </record>

        <!-- ====================================================
             6. NGHỈ BÙ (Compensatory Leave)
             - Không cần allocation (nghỉ tự do)
             - Manager trực tiếp duyệt
             - Có lương
        ==================================================== -->
        <record id="hb_leave_type_compensatory" model="hr.leave.type">
            <field name="name">Nghỉ Bù</field>
            <field name="time_type">leave</field>
            <field name="requires_allocation">False</field>
            <field name="leave_validation_type">hr</field>
            <field name="unpaid">False</field>
            <!-- Phase 6: cho phép nghỉ nửa ngày (Sáng/Chiều) -->
            <field name="request_unit">half_day</field>
            <field name="color">6</field>
        </record>

        <!-- ====================================================
             7. NGHỈ VIỆC RIÊNG (Personal Leave)
             - Không cần allocation (nghỉ tự do)
             - Manager trực tiếp duyệt
             - Có lương
        ==================================================== -->
        <record id="hb_leave_type_personal" model="hr.leave.type">
            <field name="name">Nghỉ Việc Riêng</field>
            <field name="time_type">leave</field>
            <field name="requires_allocation">False</field>
            <field name="leave_validation_type">hr</field>
            <field name="unpaid">False</field>
            <!-- Phase 6: cho phép nghỉ nửa ngày (Sáng/Chiều) -->
            <field name="request_unit">half_day</field>
            <field name="color">8</field>
        </record>

        <!-- ====================================================
             5. NGHỈ KHẨN CẤP (Emergency Leave)
             - Không cần allocation
             - Chỉ cần Manager duyệt 1 bước (fast-track)
             - Có lương (tối đa 3 ngày/năm theo chính sách HB)
             - Logic fast-track sẽ được mở rộng ở Phase 4
        ==================================================== -->
        <record id="hb_leave_type_emergency" model="hr.leave.type">
            <field name="name">Nghỉ Khẩn Cấp</field>
            <field name="time_type">leave</field>
            <field name="requires_allocation">False</field>
            <field name="leave_validation_type">hr</field>
            <field name="unpaid">False</field>
            <!-- cho phép nghỉ nửa ngày (Sáng/Chiều) -->
            <field name="request_unit">half_day</field>
            <field name="color">3</field>
        </record>

        <!-- ====================================================
             8. NGHỈ BUỔI DẠY (Teaching Session Off) — riêng cho giáo viên
             - GV xin nghỉ theo TỪNG buổi dạy (session-first), không theo ngày.
             - KHÔNG cần allocation → KHÔNG trừ quỹ phép (chỉ là đổi lịch dạy).
             - Có lương; HR Officer duyệt; không cần chứng từ.
        ==================================================== -->
        <record id="hb_leave_type_teaching_off" model="hr.leave.type">
            <field name="name">Nghỉ Buổi Dạy</field>
            <field name="time_type">leave</field>
            <field name="requires_allocation">False</field>
            <field name="leave_validation_type">hr</field>
            <field name="unpaid">False</field>
            <field name="request_unit">day</field>
            <field name="color">7</field>
        </record>

    </data>
</odoo>
