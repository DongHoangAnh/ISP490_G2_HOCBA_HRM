<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        CRON-TO-001: Nhắc nhở số dư nghỉ phép cuối tháng.

        - Chạy mỗi ngày một lần. Hàm tự kiểm tra cửa sổ cuối tháng (từ ngày 25).
        - nextcall đặt ở 00:00 UTC = 07:00 Asia/Ho_Chi_Minh (UTC+7).
          ir.cron của Odoo 19 KHÔNG có field 'tz' — giờ chạy được điều khiển
          qua nextcall (lưu theo UTC).
        - Backed by ir.actions.server (ir.cron _inherits): dùng model_id + state=code.
    -->
    <record id="ir_cron_leave_balance_reminder" model="ir.cron">
        <field name="name">HB: Nhắc nhở số dư nghỉ phép (CRON-TO-001)</field>
        <field name="model_id" ref="model_hb_timeoff_cron"/>
        <field name="state">code</field>
        <field name="code">model._cron_leave_balance_reminder()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="nextcall"
               eval="(DateTime.now().replace(hour=0, minute=0, second=0, microsecond=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
