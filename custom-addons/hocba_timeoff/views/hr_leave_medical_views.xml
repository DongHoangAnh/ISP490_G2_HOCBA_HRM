<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        FUNC-TO-002: Chứng từ y tế cho Nghỉ Ốm
        BR-011: HR Manager bypass với override checkbox + lý do bắt buộc
        BR-012: Validation tại Draft→Confirm (file type/size) và Confirm→Approve (yêu cầu có file)
    -->
    <record id="view_hr_leave_form_hb_medical" model="ir.ui.view">
        <field name="name">hr.leave.form.hb.medical</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <!-- Helper fields cho invisible conditions -->
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="leave_type_support_document" invisible="1"/>
                <field name="x_has_medical_doc" invisible="1"/>
                <field name="x_medical_override" invisible="1"/>
            </xpath>

            <!--
                Hiển thị field đính kèm:
                - Luôn hiện khi loại nghỉ yêu cầu chứng từ
                - Hiện ở state = 'confirm' cho mọi loại (hành vi mặc định Odoo)
            -->
            <xpath expr="//field[@name='supported_attachment_ids']" position="attributes">
                <attribute name="invisible">state != 'confirm' and not leave_type_support_document</attribute>
                <attribute name="string">Chứng từ y tế</attribute>
            </xpath>

            <!-- Hướng dẫn file type/size cho nhân viên khi submit -->
            <xpath expr="//field[@name='supported_attachment_ids']" position="before">
                <div class="text-muted small mb-1"
                     invisible="not leave_type_support_document or state != 'confirm'">
                    Vui lòng đính kèm chứng từ y tế.
                    Chỉ chấp nhận <strong>PDF, JPG, PNG</strong> — tối đa <strong>5 MB</strong> mỗi file.
                </div>
            </xpath>

            <!-- Cảnh báo HR khi đơn nghỉ ốm chưa có chứng từ và chưa override -->
            <xpath expr="//field[@name='leave_type_increases_duration']" position="after">
                <div class="alert alert-warning d-flex align-items-start mt-2"
                     role="alert"
                     invisible="not leave_type_support_document or x_has_medical_doc or x_medical_override"
                     groups="hr.group_hr_user">
                    <i class="fa fa-exclamation-triangle me-2 mt-1"/>
                    <span>
                        Đơn nghỉ ốm chưa có chứng từ y tế.
                        HR Manager có thể bật "Bỏ qua yêu cầu chứng từ" bên dưới để phê duyệt.
                    </span>
                </div>

                <!-- BR-011: Override section — chỉ HR Manager mới thấy -->
                <group invisible="not leave_type_support_document"
                       groups="hr.group_hr_manager">
                    <field name="x_medical_override"
                           string="Bỏ qua yêu cầu chứng từ (BR-011)"/>
                    <field name="x_medical_override_reason"
                           invisible="not x_medical_override"
                           required="x_medical_override"
                           placeholder="Nhập lý do bắt buộc khi bỏ qua yêu cầu chứng từ..."/>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
