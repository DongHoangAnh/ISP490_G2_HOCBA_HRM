<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Nhóm Academic Manager — có quyền phê duyệt đơn nghỉ của giảng viên
            khi phát hiện xung đột lịch dạy (FUNC-TO-004 / AUT-TO-002).
            HR Admin gán user vào nhóm này qua Settings > Users.
        -->
        <record id="group_academic_manager" model="res.groups">
            <field name="name">Academic Manager</field>
            <field name="sequence">30</field>
            <field name="privilege_id" ref="hr_holidays.res_groups_privilege_time_off"/>
            <field name="comment">Phê duyệt đơn nghỉ của giảng viên khi phát hiện xung đột lịch dạy.</field>
            <field name="implied_ids" eval="[(4, ref('hr_holidays.group_hr_holidays_user'))]"/>
        </record>
    </data>
</odoo>
