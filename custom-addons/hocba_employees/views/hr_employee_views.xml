<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form: thêm trang "Thông tin Học Bá" với 4 trục phân loại + mốc chính thức -->
        <record id="view_employee_form_hocba" model="ir.ui.view">
            <field name="name">hr.employee.form.hocba</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <!-- F-001: statusbar Thử việc → Chính thức → Nghỉ việc -->
                <xpath expr="//form/header" position="inside">
                    <field name="x_employment_status" widget="statusbar"
                           statusbar_visible="probation,official,resigned"/>
                </xpath>
                <!-- F-001: hàng chip phân loại [Mã NS] [Hình thức] [Tình trạng] -->
                <xpath expr="//div[hasclass('oe_title')]/h1" position="after">
                    <div class="hb_chip_row">
                        <span class="badge text-bg-dark" invisible="not x_employee_code">
                            <field name="x_employee_code" readonly="1"/>
                        </span>
                        <field name="x_work_form" widget="badge"/>
                        <field name="x_employment_status" widget="badge"
                               decoration-success="x_employment_status == 'official'"
                               decoration-warning="x_employment_status == 'probation'"
                               decoration-danger="x_employment_status == 'exiting'"
                               decoration-info="x_employment_status in ('intern', 'parttime', 'ctv', 'advisor')"/>
                    </div>
                </xpath>
                <!-- Smart buttons: Tài sản (BR-052) + Chứng chỉ + Thăng tiến -->
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_hocba_assets" type="object"
                            class="oe_stat_button" icon="fa-laptop">
                        <field name="x_asset_count" widget="statinfo" string="Tài sản"/>
                    </button>
                    <button name="action_view_hocba_certs" type="object"
                            class="oe_stat_button" icon="fa-certificate"
                            groups="hr.group_hr_user">
                        <field name="x_cert_alert_count" widget="statinfo"
                               string="CC sắp hết hạn"/>
                    </button>
                    <button name="action_view_hocba_promotions" type="object"
                            class="oe_stat_button" icon="fa-line-chart"
                            groups="hr.group_hr_user">
                        <field name="x_promotion_count" widget="statinfo" string="Thăng tiến"/>
                    </button>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Thông tin Học Bá" name="hocba_info">
                        <group>
                            <group string="Định danh &amp; Phân loại">
                                <field name="x_employee_code"/>
                                <field name="x_work_form"/>
                                <field name="x_employment_status"/>
                                <field name="x_position_type"/>
                                <field name="x_employee_type_id"/>
                            </group>
                            <group string="Mốc chính thức">
                                <field name="x_official_date"/>
                                <field name="x_official_months" widget="float" readonly="1"/>
                            </group>
                        </group>
                        <!-- F-001: mini-timeline 5 điểm (Nhóm B) -->
                        <group invisible="x_position_type not in ('staff', 'manager') or x_work_form != 'offline'">
                            <field name="x_probation_timeline_html" nolabel="1"
                                   colspan="2" readonly="1"/>
                        </group>
                        <!-- F-004: chỉ hiện với Nhóm B — BR-030 -->
                        <group string="Dòng thời gian thử việc (2 cổng — Nhóm B)"
                               invisible="x_position_type not in ('staff', 'manager') or x_work_form != 'offline'">
                            <group string="Cổng tuần-2 (cấp thiết bị)">
                                <field name="x_probation_start"/>
                                <field name="x_eval_2w_due"/>
                                <field name="x_eval_2w_result"/>
                                <field name="x_eval_2w_date" invisible="x_eval_2w_result == 'draft'"/>
                                <field name="x_eval_2w_evaluator_id" invisible="x_eval_2w_result == 'draft'"/>
                                <field name="x_eval_2w_note"/>
                                <field name="x_equip_grant_date" readonly="1"/>
                            </group>
                            <group string="Cổng tháng-2 (lên chính thức)">
                                <field name="x_eval_2m_due"/>
                                <field name="x_eval_2m_result" readonly="x_eval_2w_result != 'pass'"/>
                                <field name="x_eval_2m_date" invisible="x_eval_2m_result == 'draft'"/>
                                <field name="x_eval_2m_evaluator_id" invisible="x_eval_2m_result == 'draft'"/>
                                <field name="x_eval_2m_note"/>
                                <field name="x_skip_auto_trigger" groups="hr.group_hr_manager"/>
                            </group>
                        </group>
                        <!-- F-008: chỉ hiện với Nhóm A (GV/CTV/Part-time/Online) -->
                        <group string="Đánh giá thử giảng (Nhóm A — giảng viên)"
                               invisible="x_work_form != 'online' and x_employment_status not in ('parttime', 'ctv', 'advisor')">
                            <group>
                                <field name="x_trial_lesson_date"/>
                                <field name="x_trial_lesson_class"/>
                                <field name="x_trial_lesson_result"/>
                            </group>
                            <group>
                                <field name="x_trial_score_method"/>
                                <field name="x_trial_score_content"/>
                                <field name="x_trial_lesson_note"/>
                            </group>
                        </group>
                    </page>
                    <!-- F-002 + F-003: Hồ sơ pháp lý VN & người phụ thuộc -->
                    <page string="Pháp lý &amp; Người phụ thuộc" name="hocba_legal">
                        <group>
                            <group string="Giấy tờ pháp lý">
                                <field name="x_id_date_issue"/>
                                <field name="x_id_place_issue"/>
                                <field name="x_pit_code"/>
                                <field name="x_social_insurance_no"/>
                                <field name="x_health_insurance_no"/>
                                <field name="x_health_care_place"/>
                            </group>
                            <group string="Địa chỉ thường trú">
                                <field name="x_permanent_state_id" options="{'no_create': True}"/>
                                <field name="x_permanent_ward"/>
                                <field name="x_permanent_street"/>
                            </group>
                        </group>
                        <group string="Địa chỉ tạm trú">
                            <field name="x_current_same_as_permanent"/>
                            <group invisible="x_current_same_as_permanent">
                                <field name="x_current_state_id" options="{'no_create': True}"/>
                                <field name="x_current_ward"/>
                                <field name="x_current_street"/>
                            </group>
                        </group>
                        <separator string="Người phụ thuộc (giảm trừ gia cảnh)"/>
                        <field name="x_active_dependent_count"/>
                        <field name="x_dependent_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="relationship"/>
                                <field name="birthday"/>
                                <field name="national_id"/>
                                <field name="date_start"/>
                                <field name="date_end"/>
                                <field name="notes"/>
                            </list>
                        </field>
                    </page>
                    <!-- Task 4: đăng ký khuôn mặt cho điểm danh (hocba_attendance) -->
                    <page string="Khuôn mặt &amp; Điểm danh" name="hocba_face">
                        <group>
                            <field name="x_face_enrolled" readonly="1"/>
                            <field name="x_face_image" widget="image" class="oe_avatar"/>
                            <field name="x_face_descriptor"
                                   widget="hocba_face_descriptor"
                                   options="{'image_field': 'x_face_image'}"/>
                        </group>
                        <div class="text-muted">
                            Tải ảnh chân dung rõ mặt; hệ thống sẽ tự tính vector khuôn mặt
                            (cần trình duyệt hỗ trợ, chạy trên localhost hoặc HTTPS).
                        </div>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- List: thêm cột mã NV, hình thức, tình trạng -->
        <record id="view_employee_tree_hocba" model="ir.ui.view">
            <field name="name">hr.employee.list.hocba</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="decoration-info">x_employment_status == 'probation'</attribute>
                    <attribute name="decoration-warning">x_employment_status == 'exiting'</attribute>
                    <attribute name="decoration-muted">x_employment_status == 'resigned'</attribute>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="x_employee_code" optional="show"/>
                    <field name="x_work_form" optional="show" widget="badge"
                           decoration-info="x_work_form == 'online'"/>
                    <field name="x_employment_status" optional="show" widget="badge"
                           decoration-success="x_employment_status == 'official'"
                           decoration-warning="x_employment_status == 'probation'"
                           decoration-danger="x_employment_status == 'exiting'"
                           decoration-info="x_employment_status in ('intern', 'parttime', 'ctv', 'advisor')"/>
                </xpath>
            </field>
        </record>

        <!-- Kanban: badge mã NV / tình trạng / hình thức (F-001 chips) -->
        <record id="view_employee_kanban_hocba" model="ir.ui.view">
            <field name="name">hr.employee.kanban.hocba</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">
                <xpath expr="//t[@t-name='card']//main" position="inside">
                    <div class="mt-1 d-flex flex-wrap gap-1">
                        <span t-if="record.x_employee_code.raw_value"
                              class="badge text-bg-dark">
                            <field name="x_employee_code"/>
                        </span>
                        <span t-if="record.x_employment_status.raw_value"
                              t-attf-class="badge {{ record.x_employment_status.raw_value == 'official' ? 'text-bg-success' : record.x_employment_status.raw_value == 'probation' ? 'text-bg-warning' : 'text-bg-secondary' }}">
                            <field name="x_employment_status"/>
                        </span>
                        <span t-if="record.x_work_form.raw_value"
                              class="badge text-bg-info">
                            <field name="x_work_form"/>
                        </span>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- List chứng chỉ (mở từ smart button "CC sắp hết hạn") -->
        <record id="hr_employee_skill_cert_list" model="ir.ui.view">
            <field name="name">hr.employee.skill.cert.list</field>
            <field name="model">hr.employee.skill</field>
            <field name="priority">99</field>
            <field name="arch" type="xml">
                <list decoration-danger="x_cert_status == 'expired'"
                      decoration-warning="x_cert_status == 'expiring'"
                      create="false" delete="false">
                    <field name="skill_id"/>
                    <field name="skill_level_id"/>
                    <field name="x_cert_date"/>
                    <field name="x_cert_expiry"/>
                    <field name="x_cert_status"/>
                    <field name="x_cert_verified" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <!-- Search: lọc & nhóm theo các trục Học Bá -->
        <record id="view_employee_filter_hocba" model="ir.ui.view">
            <field name="name">hr.employee.search.hocba</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_filter"/>
            <field name="arch" type="xml">
                <!-- Field tìm theo mã NV (chèn giữa khối field gốc) -->
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="x_employee_code"/>
                </xpath>
                <!-- Bộ lọc nhanh: chèn sau filter "Archived" (trước nhóm Group By) -->
                <xpath expr="//filter[@name='inactive']" position="after">
                    <separator/>
                    <filter name="hocba_probation" string="Thử việc"
                            domain="[('x_employment_status', '=', 'probation')]"/>
                    <filter name="hocba_official" string="Chính thức"
                            domain="[('x_employment_status', '=', 'official')]"/>
                    <separator/>
                    <filter name="hocba_offline" string="Offline"
                            domain="[('x_work_form', '=', 'offline')]"/>
                    <filter name="hocba_online" string="Online"
                            domain="[('x_work_form', '=', 'online')]"/>
                </xpath>
                <!-- Group By: nhét vào nhóm "Group By" sẵn có của Odoo -->
                <xpath expr="//filter[@name='group_category_ids']" position="after">
                    <filter name="group_work_form" string="Hình thức"
                            context="{'group_by': 'x_work_form'}"/>
                    <filter name="group_employment_status" string="Tình trạng"
                            context="{'group_by': 'x_employment_status'}"/>
                    <filter name="group_position_type" string="Loại vị trí"
                            context="{'group_by': 'x_position_type'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
