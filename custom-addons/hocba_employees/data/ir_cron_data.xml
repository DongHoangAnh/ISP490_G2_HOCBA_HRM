<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- CRON nhắc đánh giá thử việc (F-005). nextcall 00:00 UTC = 7:00 SA VN -->
        <record id="cron_probation_eval_reminder" model="ir.cron">
            <field name="name">HOCBA: Nhắc đánh giá thử việc (2 cổng)</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_probation_eval_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- F-009: cảnh báo chứng chỉ sắp hết hạn (ngưỡng GĐ-08, configurable) -->
        <record id="config_cert_alert_days" model="ir.config_parameter">
            <field name="key">hoc_ba.cert_alert_days</field>
            <field name="value">60</field>
        </record>
        <record id="cron_cert_expiry_alert" model="ir.cron">
            <field name="name">HOCBA: Cảnh báo chứng chỉ sắp hết hạn</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_cert_expiry_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:05:00')"/>
            <field name="active" eval="True"/>
        </record>

        <!-- Nhắc hạn hợp đồng (hr.version.contract_date_end) sắp hết trong 30 ngày -->
        <record id="cron_contract_end_alert" model="ir.cron">
            <field name="name">HOCBA: Nhắc hợp đồng sắp hết hạn</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model._cron_contract_end_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:10:00')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
