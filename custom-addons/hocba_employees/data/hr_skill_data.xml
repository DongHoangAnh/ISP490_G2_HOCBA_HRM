<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CONF-EMP-04/05 + BR-070 + họp #2: gom thành "Bằng ngôn ngữ" & "Bằng chuyên môn" -->
    <data noupdate="1">
