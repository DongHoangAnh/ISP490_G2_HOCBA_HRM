    <!-- Đổi tên nhóm trên DB đã cài (họp #2) -->
    <data noupdate="0">
        <record id="skill_type_chinese" model="hr.skill.type">
            <field name="name">Bằng ngôn ngữ</field>
        </record>
        <record id="skill_type_pedagogy" model="hr.skill.type">
            <field name="name">Bằng chuyên môn</field>
        </record>
