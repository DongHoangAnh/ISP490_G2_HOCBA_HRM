    <!-- ═══════════════ SỐ ĐIỆN THOẠI / EMAIL TRÊN HEADER ═══════════════
         Bản gốc của Odoo nhét cứng "+1 555-555-5556" và
         "info@yourcompany.example.com". Thay bằng dữ liệu công ty
         (data/branding_data.xml) để sau này đổi số chỉ cần sửa hồ sơ công ty. -->
    <template id="hb_header_text_element" inherit_id="website.header_text_element"
              name="HB: Lien he tren header">
        <!-- Ban goc cua Odoo nhet cung so/email demo o 5 nhanh tuy chon giao
             dien. Moi xpath duoi day bat DUNG mot the <a> con lai mang gia tri
             demo (Odoo lay ket qua dau tien), theo thu tu tai lieu:
               tel  #1 -> nhanh phone_mail
               tel  #2 -> nhanh mail_stretched
               tel  #3 -> nhanh mac dinh (t-else)
               mail #1 -> nhanh phone_mail
               mail #2 -> nhanh mail
             Thay bang du lieu cong ty (data/branding_data.xml) de sau nay doi
             so chi can sua ho so cong ty. `res_company` do website.layout dat. -->
        <xpath expr="//a[@href='tel:+1 555-555-5556']" position="replace">
            <a t-attf-href="tel:#{res_company.phone}" class="nav-link o_nav-link_secondary">
                <small>
                    <i class="fa fa-1x fa-fw fa-phone me-1"/>
                    <span class="o_force_ltr" t-out="res_company.phone"/>
                </small>
            </a>
        </xpath>
        <xpath expr="//a[@href='tel:+1 555-555-5556']" position="replace">
            <a t-attf-href="tel:#{res_company.phone}"
               class="nav-link o_nav-link_secondary p-2 o_navlink_background_hover d-flex align-items-center h-100 text-reset">
                <i class="fa fa-1x fa-fw fa-phone me-1"/>
                <span class="o_force_ltr"><small t-out="res_company.phone"/></span>
            </a>
        </xpath>
        <xpath expr="//a[@href='tel:+1 555-555-5556']" position="replace">
            <a t-attf-href="tel:#{res_company.phone}" class="nav-link o_nav-link_secondary p-2">
                <i class="fa fa-1x fa-fw fa-phone me-1"/>
                <span class="o_force_ltr"><small t-out="res_company.phone"/></span>
            </a>
        </xpath>
        <xpath expr="//a[@href='mailto:info@yourcompany.example.com']" position="replace">
            <a t-attf-href="mailto:#{res_company.email}" class="nav-link o_nav-link_secondary">
                <small>
                    <i class="fa fa-1x fa-fw fa-envelope me-1"/>
                    <t t-out="res_company.email"/>
                </small>
            </a>
        </xpath>
        <xpath expr="//a[@href='mailto:info@yourcompany.example.com']" position="replace">
            <a t-attf-href="mailto:#{res_company.email}" class="nav-link o_nav-link_secondary">
                <small><i class="fa fa-1x fa-fw fa-envelope me-1"/> <t t-out="res_company.email"/></small>
            </a>
        </xpath>
    </template>

    <!-- ═══════════════ DÒNG COPYRIGHT ═══════════════
         `website.footer_copyright_company_name` (priority 15) thay tên công ty
         động của Odoo bằng chữ "Company name" gõ cứng → footer hiện "Bản quyền
         © Tên công ty". Trả lại tên công ty thật. -->
    <template id="hb_footer_copyright_company_name" inherit_id="website.footer_copyright_company_name"
              name="HB: Tên công ty ở dòng copyright">
        <xpath expr="//footer//span[hasclass('o_footer_copyright_name')]" position="replace">
            <span class="o_footer_copyright_name me-2 small">
                Copyright © <span t-field="res_company.name" itemprop="name">Học Bá Education</span>
            </span>
        </xpath>
    </template>

    <!-- ═══════════════ ẨN &quot;Powered by Odoo&quot; ═══════════════ -->
    <template id="hb_hide_brand_promotion" inherit_id="web.brand_promotion"
              name="HB: ẩn brand promotion">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace"/>
    </template>

</odoo>
