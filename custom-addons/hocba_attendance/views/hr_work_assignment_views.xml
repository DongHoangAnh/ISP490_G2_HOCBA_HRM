<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Work Assignment Form View -->
        <record id="hocba_work_assignment_form" model="ir.ui.view">
            <field name="name">Work Assignment Form</field>
            <field name="model">hocba.work_assignment</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name" required="1"/>
                            <field name="employee_id" required="1"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="job_title"/>
                            <field name="project_name"/>
                            <field name="assigned_date" required="1"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>
                        <separator string="Statistics"/>
                        <group>
                            <field name="attendance_count"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Work Assignment Tree View -->
        <record id="hocba_work_assignment_tree" model="ir.ui.view">
            <field name="name">Work Assignment Tree</field>
            <field name="model">hocba.work_assignment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="project_name"/>
                    <field name="assigned_date"/>
                    <field name="end_date"/>
                    <field name="attendance_count" sum="count"/>
                </list>
            </field>
        </record>

        <!-- Work Assignment Search View -->
        <record id="hocba_work_assignment_search" model="ir.ui.view">
            <field name="name">Work Assignment Search</field>
            <field name="model">hocba.work_assignment</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="project_name"/>
                    <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                    <filter name="filter_ongoing" string="Ongoing" domain="[('end_date', '=', False)]"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
