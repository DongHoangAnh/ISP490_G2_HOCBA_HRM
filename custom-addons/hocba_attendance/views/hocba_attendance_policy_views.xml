<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hocba_attendance_policy_form" model="ir.ui.view">
            <field name="name">Attendance Policy Form</field>
            <field name="model">hocba.attendance.policy</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                        </group>
                        <group string="Khung giờ (giờ địa phương)">
                            <group>
                                <field name="morning_start"/>
                                <field name="morning_end"/>
                            </group>
                            <group>
                                <field name="evening_start"/>
                                <field name="evening_end"/>
                            </group>
                        </group>
                        <group string="Ngày làm việc">
                            <field name="workday_mon"/>
                            <field name="workday_tue"/>
                            <field name="workday_wed"/>
                            <field name="workday_thu"/>
                            <field name="workday_fri"/>
                            <field name="workday_sat"/>
                            <field name="workday_sun"/>
                        </group>
                        <group string="Kỳ tính công">
                            <field name="period_start_day"/>
                            <field name="period_end_day"/>
                            <field name="default_location_id"/>
                            <field name="default_map_url" widget="url" readonly="1"/>
                        </group>
                        <group string="Vị trí chấm công hợp lệ (cơ sở)">
                            <field name="office_location_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="lat"/>
                                    <field name="lng"/>
                                    <field name="radius_m"/>
                                    <field name="active"/>
                                    <field name="map_url" widget="url" readonly="1"/>
                                </list>
                            </field>
                        </group>
                        <group string="Văn phòng (legacy, fallback)">
                            <field name="office_map_url" widget="url"/>
                            <field name="office_lat"/>
                            <field name="office_lng"/>
                            <field name="office_radius_m"/>
                        </group>
                        <group string="Nhận diện khuôn mặt">
                            <field name="face_threshold"/>
                        </group>
                        <group string="Tính công">
                            <field name="late_cutoff"/>
                            <field name="morning_credit_cutoff"/>
                            <field name="std_work_hours"/>
                            <field name="afternoon_margin_hours"/>
                            <field name="violation_free_days"/>
                            <field name="shift_window_minutes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hocba_attendance_policy_tree" model="ir.ui.view">
            <field name="name">Attendance Policy List</field>
            <field name="model">hocba.attendance.policy</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="period_start_day"/>
                    <field name="period_end_day"/>
                    <field name="office_radius_m"/>
                    <field name="default_location_id" optional="show"/>
                    <field name="default_map_url" widget="url" optional="show"/>
                    <field name="face_threshold"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="hocba_attendance_policy_action" model="ir.actions.act_window">
            <field name="name">Attendance Policy</field>
            <field name="res_model">hocba.attendance.policy</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Lịch sử chu kỳ chấm công -->
        <record id="hocba_attendance_period_history_view_tree" model="ir.ui.view">
            <field name="name">hocba.attendance.period.history.tree</field>
            <field name="model">hocba.attendance.period.history</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="apply_from"/>
                    <field name="period_start_day"/>
                </list>
            </field>
        </record>

        <record id="hocba_attendance_period_history_action" model="ir.actions.act_window">
            <field name="name">Lịch sử Chu kỳ Chấm công</field>
            <field name="res_model">hocba.attendance.period.history</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>
