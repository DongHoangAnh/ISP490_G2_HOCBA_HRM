<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Vietcombank -->
        <record id="bank_format_vcb" model="hb.bank.format">
            <field name="name">Vietcombank</field>
            <field name="code">VCB</field>
            <field name="sequence">10</field>
            <field name="formatter_class">VCBFormatter</field>
            <field name="encoding">utf-8-sig</field>
            <field name="file_extension">xlsx</field>
            <field name="account_format_regex">^\d{10,14}$</field>
            <field name="description_template">Luong T{month}/{year} - {employee_code}</field>
        </record>

        <!-- Techcombank -->
        <record id="bank_format_tcb" model="hb.bank.format">
            <field name="name">Techcombank</field>
            <field name="code">TCB</field>
            <field name="sequence">20</field>
            <field name="formatter_class">TCBFormatter</field>
            <field name="encoding">utf-8</field>
            <field name="file_extension">xlsx</field>
            <field name="account_format_regex">^\d{14}$</field>
            <field name="description_template">Luong T{month}/{year} - {employee_code}</field>
        </record>
    </data>
</odoo>
