<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron: Auto-confirm payslips past confirmation deadline -->
        <record id="ir_cron_auto_confirm_payslip" model="ir.cron">
            <field name="name">Payroll: Tự động xác nhận phiếu lương hết hạn</field>
            <field name="model_id" ref="model_hb_payslip"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_confirm_expired()</field>
            <field name="interval_number">2</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
