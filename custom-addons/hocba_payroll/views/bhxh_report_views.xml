<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- BHXH Report Form -->
    <record id="hb_bhxh_report_form" model="ir.ui.view">
        <field name="name">hb.bhxh.report.form</field>
        <field name="model">hb.bhxh.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_compute" string="Tính BHXH"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_submitted" string="Đánh dấu Đã nộp"
                            type="object" class="btn-success"
                            invisible="state != 'computed'"/>
                    <button name="action_reset_draft" string="Reset Nháp"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,computed,submitted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="period_month"/>
                            <field name="period_year"/>
                            <field name="batch_id"/>
                        </group>
                        <group>
                            <field name="employee_count"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Tổng hợp">
                        <group string="Phần NV đóng">
                            <field name="total_bhxh_ee" widget="monetary"/>
                            <field name="total_bhyt_ee" widget="monetary"/>
                            <field name="total_bhtn_ee" widget="monetary"/>
                        </group>
                        <group string="Phần DN đóng">
                            <field name="total_bhxh_er" widget="monetary"/>
                            <field name="total_bhyt_er" widget="monetary"/>
                            <field name="total_bhtn_er" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Chi tiết theo nhân viên">
                            <field name="line_ids" nolabel="1">
                                <list>
                                    <field name="employee_code"/>
                                    <field name="employee_id"/>
                                    <field name="social_insurance_no"/>
                                    <field name="insurance_base" widget="monetary"/>
                                    <field name="bhxh_ee" widget="monetary"/>
                                    <field name="bhyt_ee" widget="monetary"/>
                                    <field name="bhtn_ee" widget="monetary"/>
                                    <field name="total_ee" widget="monetary"/>
                                    <field name="bhxh_er" widget="monetary"/>
                                    <field name="bhyt_er" widget="monetary"/>
                                    <field name="bhtn_er" widget="monetary"/>
                                    <field name="total_er" widget="monetary"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- BHXH Report List -->
    <record id="hb_bhxh_report_tree" model="ir.ui.view">
        <field name="name">hb.bhxh.report.tree</field>
        <field name="model">hb.bhxh.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <field name="batch_id"/>
                <field name="employee_count"/>
                <field name="total_bhxh_ee" widget="monetary"/>
                <field name="total_bhyt_ee" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'computed'"
                       decoration-success="state == 'submitted'"/>
            </list>
        </field>
    </record>

    <!-- BHXH Report Action -->
    <record id="action_hb_bhxh_report" model="ir.actions.act_window">
        <field name="name">Báo cáo BHXH</field>
        <field name="res_model">hb.bhxh.report</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
