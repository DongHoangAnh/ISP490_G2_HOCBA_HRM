<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_revenue_form" model="ir.ui.view">
        <field name="name">hocba.sale.revenue.form</field>
        <field name="model">hocba.sale.revenue</field>
        <field name="arch" type="xml">
            <form string="Doanh thu Sale">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="period_month"/>
                            <field name="period_year"/>
                        </group>
                        <group>
                            <field name="revenue"/>
                            <field name="level_id"/>
                            <field name="commission"/>
                            <field name="sale_wage"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_revenue_list" model="ir.ui.view">
        <field name="name">hocba.sale.revenue.list</field>
        <field name="model">hocba.sale.revenue</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <field name="revenue"/>
                <field name="level_id"/>
                <field name="commission"/>
                <field name="sale_wage"/>
            </list>
        </field>
    </record>

    <record id="view_sale_revenue_search" model="ir.ui.view">
        <field name="name">hocba.sale.revenue.search</field>
        <field name="model">hocba.sale.revenue</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="period_month"/>
                <field name="period_year"/>
                <group>
                    <filter string="Nhân viên" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Tháng" name="group_month" context="{'group_by': 'period_month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_revenue" model="ir.actions.act_window">
        <field name="name">Doanh thu Sale</field>
        <field name="res_model">hocba.sale.revenue</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
