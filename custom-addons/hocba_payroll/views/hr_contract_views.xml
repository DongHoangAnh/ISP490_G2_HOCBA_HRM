<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract Form -->
    <record id="hb_contract_form" model="ir.ui.view">
        <field name="name">hb.contract.form</field>
        <field name="model">hb.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" string="Xác nhận"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Kết thúc"
                            type="object"
                            invisible="state != 'open'"/>
                    <button name="action_cancel" string="Hủy"
                            type="object"
                            invisible="state in ('cancel', 'close')"/>
                    <button name="action_reset_draft" string="Reset Nháp"
                            type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,open"/>
                </header>
                <sheet>
                    <group>
                        <group string="Thông tin hợp đồng">
                            <field name="name"/>
                            <field name="employee_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="wage" widget="monetary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Đơn giá giờ dạy">
                            <field name="x_teaching_hourly_rate"/>
                            <field name="x_rate_hsk_class"/>
                            <field name="x_rate_advanced_class"/>
                        </group>
                    </group>
                    <group>
                        <group string="Ngưỡng &amp; Bonus">
                            <field name="x_standard_threshold"/>
                            <field name="x_extra_rate"/>
                            <field name="x_effective_extra_rate" readonly="1"/>
                        </group>
                        <group string="Lương cố định">
                            <field name="x_has_fixed_base"/>
                            <field name="x_fixed_base"
                                   invisible="not x_has_fixed_base"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Contract List -->
    <record id="hb_contract_tree" model="ir.ui.view">
        <field name="name">hb.contract.tree</field>
        <field name="model">hb.contract</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="wage"/>
                <field name="x_teaching_hourly_rate"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'open'"
                       decoration-muted="state in ('close', 'cancel')"/>
            </list>
        </field>
    </record>

    <!-- Contract Search -->
    <record id="hb_contract_search" model="ir.ui.view">
        <field name="name">hb.contract.search</field>
        <field name="model">hb.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="filter_open" string="Đang hiệu lực"
                        domain="[('state', '=', 'open')]"/>
                <filter name="filter_draft" string="Nháp"
                        domain="[('state', '=', 'draft')]"/>
                <group>
                    <filter name="group_by_employee" string="Nhân viên"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_state" string="Trạng thái"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Contract Action -->
    <record id="action_hb_contract" model="ir.actions.act_window">
        <field name="name">Hợp đồng giáo viên</field>
        <field name="res_model">hb.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_open': 1}</field>
    </record>
</odoo>
