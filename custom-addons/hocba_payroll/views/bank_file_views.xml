<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bank File Form -->
    <record id="hb_bank_file_form" model="ir.ui.view">
        <field name="name">hb.bank.file.form</field>
        <field name="model">hb.bank.file</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_uploaded" string="Đánh dấu Uploaded"
                            type="object" class="btn-primary"
                            invisible="state != 'generated'"/>
                    <button name="action_mark_confirmed" string="Xác nhận NH"
                            type="object" class="btn-success"
                            invisible="state != 'uploaded'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="generated,uploaded,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="batch_id"/>
                            <field name="bank_format_id"/>
                            <field name="payment_date"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary"/>
                            <field name="record_count"/>
                            <field name="generated_by"/>
                            <field name="generated_at"/>
                        </group>
                    </group>
                    <group>
                        <field name="attachment_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Bank File List -->
    <record id="hb_bank_file_tree" model="ir.ui.view">
        <field name="name">hb.bank.file.tree</field>
        <field name="model">hb.bank.file</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="batch_id"/>
                <field name="bank_format_id"/>
                <field name="payment_date"/>
                <field name="total_amount" widget="monetary"/>
                <field name="record_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'generated'"
                       decoration-warning="state == 'uploaded'"
                       decoration-success="state == 'confirmed'"/>
                <field name="generated_at"/>
            </list>
        </field>
    </record>

    <!-- Bank File Action -->
    <record id="action_hb_bank_file" model="ir.actions.act_window">
        <field name="name">File Ngân hàng</field>
        <field name="res_model">hb.bank.file</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
