<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_level_form" model="ir.ui.view">
        <field name="name">hocba.sale.level.form</field>
        <field name="model">hocba.sale.level</field>
        <field name="arch" type="xml">
            <form string="Bậc hoa hồng Sale">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="level"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="kpi_threshold" widget="monetary" options="{'currency_id': False}"/>
                            <field name="commission_rate" widget="percentage"/>
                            <field name="base_sale_wage" widget="monetary" options="{'currency_id': False}"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_level_list" model="ir.ui.view">
        <field name="name">hocba.sale.level.list</field>
        <field name="model">hocba.sale.level</field>
        <field name="arch" type="xml">
            <list>
                <field name="level"/>
                <field name="name"/>
                <field name="kpi_threshold"/>
                <field name="commission_rate" widget="percentage"/>
                <field name="base_sale_wage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_sale_level" model="ir.actions.act_window">
        <field name="name">Bậc hoa hồng Sale</field>
        <field name="res_model">hocba.sale.level</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
