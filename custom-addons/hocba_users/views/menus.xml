<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- User Management Menu (under the HOCBA HRM app) -->
        <menuitem name="User Management" id="hocba_users_menu_root" parent="hocba_attendance.hocba_hrm_root" sequence="30"/>

        <!-- HOCBA Users -->
        <record id="hocba_user_action" model="ir.actions.act_window">
            <field name="name">HOCBA Users</field>
            <field name="res_model">hocba.user</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem name="Users" id="hocba_user_menu" parent="hocba_users_menu_root" action="hocba_user_action" sequence="10"/>

        <!-- User Roles -->
        <record id="hocba_user_role_action" model="ir.actions.act_window">
            <field name="name">User Roles</field>
            <field name="res_model">hocba.user.role</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem name="User Roles" id="hocba_user_role_menu" parent="hocba_users_menu_root" action="hocba_user_role_action" sequence="20"/>

        <!-- Employee Types -->
        <record id="hocba_employee_type_action" model="ir.actions.act_window">
            <field name="name">Employee Types</field>
            <field name="res_model">hocba.employee.type</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem name="Employee Types" id="hocba_employee_type_menu" parent="hocba_users_menu_root" action="hocba_employee_type_action" sequence="30"/>

        <!-- Access Control -->
        <record id="hocba_access_control_action" model="ir.actions.act_window">
            <field name="name">Access Control</field>
            <field name="res_model">hocba.access.control</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem name="Access Control" id="hocba_access_control_menu" parent="hocba_users_menu_root" action="hocba_access_control_action" sequence="40"/>

        <!-- Department Managers -->
        <record id="hocba_department_manager_action" model="ir.actions.act_window">
            <field name="name">Department Managers</field>
            <field name="res_model">hocba.department.manager</field>
            <field name="view_mode">list,form</field>
        </record>
        <menuitem name="Department Managers" id="hocba_department_manager_menu" parent="hocba_users_menu_root" action="hocba_department_manager_action" sequence="50"/>
    </data>
</odoo>
