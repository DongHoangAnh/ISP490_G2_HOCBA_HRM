<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- HOCBA User Form View -->
        <record id="hocba_user_form" model="ir.ui.view">
            <field name="name">HOCBA User Form</field>
            <field name="model">hocba.user</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_activate" string="Activate" type="object"
                                invisible="is_active" class="btn-success"/>
                        <button name="action_deactivate" string="Deactivate" type="object"
                                invisible="not is_active" class="btn-warning"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="user_id" required="1"/>
                                <field name="email"/>
                            </group>
                            <group>
                                <field name="role_id" required="1"/>
                                <field name="role_code"/>
                                <field name="is_active"/>
                            </group>
                        </group>
                        <group string="Employee Info">
                            <field name="employee_id"/>
                            <field name="employee_type_id"/>
                            <field name="department_id"/>
                        </group>
                        <group string="Login Info">
                            <field name="last_login"/>
                            <field name="created_at"/>
                            <field name="updated_at"/>
                        </group>
                        <notebook>
                            <page string="Access Control">
                                <field name="access_control_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="module_name"/>
                                        <field name="action"/>
                                        <field name="allowed"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Managed Departments">
                                <field name="department_manager_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="department_id"/>
                                        <field name="can_manage_attendance"/>
                                        <field name="can_manage_leaves"/>
                                        <field name="can_manage_employees"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- HOCBA User Tree View -->
        <record id="hocba_user_tree" model="ir.ui.view">
            <field name="name">HOCBA User Tree</field>
            <field name="model">hocba.user</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="email"/>
                    <field name="role_id"/>
                    <field name="employee_type_id"/>
                    <field name="department_id"/>
                    <field name="is_active"/>
                    <field name="last_login"/>
                </list>
            </field>
        </record>

        <!-- HOCBA User Search View -->
        <record id="hocba_user_search" model="ir.ui.view">
            <field name="name">HOCBA User Search</field>
            <field name="model">hocba.user</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="email"/>
                    <field name="role_id"/>
                    <field name="employee_type_id"/>
                    <field name="department_id"/>
                    <filter name="filter_active" string="Active" domain="[('is_active', '=', True)]"/>
                    <filter name="filter_admin" string="Admins" domain="[('role_code', '=', 'admin')]"/>
                    <filter name="filter_hr" string="HR Managers" domain="[('role_code', '=', 'hr_manager')]"/>
                    <filter name="filter_employee" string="Employees" domain="[('role_code', '=', 'employee')]"/>
                    <separator/>
                    <group>
                        <filter name="group_by_role" string="Role" context="{'group_by': 'role_id'}"/>
                        <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                        <filter name="group_by_type" string="Employee Type" context="{'group_by': 'employee_type_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
