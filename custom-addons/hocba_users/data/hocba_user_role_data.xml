<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 4 role chuẩn theo HRM_SYSTEM_GUIDE — group_ids = quyền Odoo thật -->
    <data noupdate="1">
        <record id="role_admin" model="hocba.user.role">
            <field name="sequence">10</field>
            <field name="name">Admin</field>
            <field name="code">admin</field>
            <field name="description">Quản trị viên — toàn quyền hệ thống</field>
            <field name="color_code">#C8102E</field>
            <field name="group_ids"
                   eval="[(6, 0, [ref('base.group_system'), ref('hr.group_hr_manager')])]"/>
        </record>
        <record id="role_hr_manager" model="hocba.user.role">
            <field name="sequence">20</field>
            <field name="name">HR Manager</field>
            <field name="code">hr_manager</field>
            <field name="description">Quản lý nhân sự — xem/quản lý toàn bộ HR, không quản trị hệ thống</field>
            <field name="color_code">#F2C200</field>
            <field name="group_ids" eval="[(6, 0, [ref('hr.group_hr_manager')])]"/>
        </record>
        <record id="role_employee" model="hocba.user.role">
            <field name="sequence">30</field>
            <field name="name">Employee</field>
            <field name="code">employee</field>
            <field name="description">Nhân viên chính thức — chỉ xem dữ liệu cá nhân</field>
            <field name="color_code">#0F766E</field>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>
        <record id="role_contractor" model="hocba.user.role">
            <field name="sequence">40</field>
            <field name="name">Contractor</field>
            <field name="code">contractor</field>
            <field name="description">Cộng tác viên — quyền tối thiểu, chỉ dữ liệu của mình</field>
            <field name="color_code">#6D28D9</field>
            <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        </record>
    </data>
</odoo>
