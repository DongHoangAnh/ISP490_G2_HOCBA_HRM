    <bpmn:serviceTask id="Task_Generate_Payslips" name="Lọc danh sách nhân sự( Ngoại trừ giáo viên)">
      <bpmn:documentation>
        Search hr.employee có hb.contract state='open' overlap kỳ lương.
        Bulk-insert hb.payslip records.
        UC-04: NV chưa có HĐ → skip, HR tạo HĐ trước.
        UC-05: NV có 2 HĐ trùng → chọn HĐ đầu tiên (limit=1).
      </bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Create_Batch" name="Tạo Đợt lương &#38; Tính lương">
      <bpmn:documentation>
        HR tạo batch trên SPA (BatchForm.jsx) hoặc Odoo backend.
        Nhập: Tên kỳ lương, Từ ngày, Đến ngày.
        State: draft, compute_status: idle.
        Dữ liệu chấm công, nghỉ phép, giờ dạy đã được NV ghi nhận
        trước đó trên các module Attendance / Time Off / WORK200.
        UC-03: HR chọn sai kỳ → xóa/sửa batch.
      </bpmn:documentation>
      <bpmn:incoming>Flow_0quq40r</bpmn:incoming>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_14ptilq" name="Có thành phần lương hay chưa ?">
